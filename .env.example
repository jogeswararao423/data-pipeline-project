# ==============================================================================
# Daily E-Commerce Sales & Customer Metrics Pipeline Configuration
# ==============================================================================

# Database Engine: 'mysql' for production MySQL 8.x/9.x, or 'sqlite' for zero-credential local testing
DB_ENGINE=sqlite

# MySQL Connection Settings (Used when DB_ENGINE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ecommerce_pipeline
MYSQL_CHARSET=utf8mb4

# SQLite Database Settings (Used when DB_ENGINE=sqlite or fallback)
SQLITE_DB_PATH=data/ecommerce_pipeline.db

# Pipeline Execution Settings
LOG_LEVEL=INFO
BATCH_SIZE=5000
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2

# Data Generation Defaults
RANDOM_SEED=42
DEFAULT_ROW_COUNT=1000
INVALID_RECORD_PCT=0.05
DUPLICATE_RECORD_PCT=0.03
LATE_EVENT_PCT=0.05
CUSTOMER_COUNT=50
PRODUCT_COUNT=20

# Output Paths
RAW_DATA_DIR=data/raw
SAMPLE_DATA_DIR=data/sample
REJECTED_DATA_DIR=data/rejected
GENERATED_DATA_DIR=data/generated
REPORTS_DIR=outputs/reports
VALIDATION_DIR=outputs/validation
SAMPLE_RESULTS_DIR=outputs/sample_results
